# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only database connections
# Runtime connection (Supavisor transaction pooler for Vercel)
DATABASE_URL=
# Keep each app instance's pool small; increase only after measuring capacity.
DATABASE_CONNECTION_LIMIT=5
# Optional local SQL debugging. Avoid enabling during normal development.
PRISMA_QUERY_LOG=false
# Migration connection (Supavisor session pooler or direct connection)
DIRECT_URL=

# Server-only integrations
SPORTSDATA_API_KEY=
CRON_SECRET=

# Invitation delivery remains disabled until a domain is verified with Resend.
# Keep the API key server-only and set INVITATION_EMAIL_ENABLED=true only after
# RESEND_FROM_EMAIL and APP_URL are production-ready.
INVITATION_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=http://localhost:3000
