{
  "name": "football-pool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run migration:check && node --test --experimental-strip-types src/lib/db/*.test.ts src/lib/draft/*.test.ts src/lib/seasons/*.test.ts src/lib/*.test.ts scripts/lib/*.test.mjs",
    "postinstall": "prisma generate",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:demo": "node scripts/seed-development.mjs --reset-development-pool",
    "db:seed:sportsdata": "node scripts/seed-development.mjs --reset-development-pool --sportsdata",
    "db:verify:demo": "node scripts/verify-development-seed.mjs",
    "migrate:2025-data": "node scripts/migrate-2025-data.mjs",
    "migrate:2025-rehearsal": "node scripts/rehearse-2025-fixture.mjs && node --test scripts/lib/legacy-2025-rehearsal.test.mjs",
    "migration:check": "node scripts/check-migration-history.mjs",
    "migration:inspect": "node scripts/inspect-migration-state.mjs",
    "backup:production": "node scripts/backup-production-postgres.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:check": "node scripts/check-supabase-setup.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prisma": "^6.19.3",
    "supabase": "^2.112.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
